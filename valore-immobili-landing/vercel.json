{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.valore-immobili.it" }],
      "destination": "https://valore-immobili.it/:path*",
      "permanent": true
    },
    { "source": "/", "destination": "/valutazione", "permanent": false },
    { "source": "/valutazione/step-2", "destination": "/valutazione/step-1", "permanent": false },
    { "source": "/valutazione/step-2c", "destination": "/valutazione/step-1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/valutazione", "destination": "/valutazione/step-1.html" },
    { "source": "/valutazione/step-1", "destination": "/valutazione/step-1.html" },
    { "source": "/valutazione/step-3", "destination": "/valutazione/step-3.html" },
    { "source": "/valutazione/(.*)", "destination": "/valutazione/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
